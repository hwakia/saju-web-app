# 사주MRI Oracle VM 환경변수 예시
# 이 파일을 .env로 복사 후 편집: cp .env.example .env

# PostgreSQL 비밀번호 (docker-compose.yml의 postgres 컨테이너용)
POSTGRES_PASSWORD=강력한비밀번호여기입력

# 관리자 모드 키
ADMIN_KEY=원하는관리자키

# (자동 생성됨 — 직접 수정 불필요)
# PG_DATABASE_URL은 docker-compose.yml에서 자동으로 조합됨:
# postgresql://saju_app:${POSTGRES_PASSWORD}@postgres:5432/saju_db
