# ─────────────────────────────────────────────────────────────
# key.properties — Android 릴리즈 서명 설정
# ─────────────────────────────────────────────────────────────
# 1) 이 파일을 복사하여 같은 폴더에 key.properties 라는 이름으로 저장
# 2) 아래 값들을 실제 키스토어 정보로 채우세요
# 3) key.properties 는 절대 git에 커밋하지 마세요! (.gitignore에 추가됨)
# ─────────────────────────────────────────────────────────────

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=YOUR_KEY_ALIAS
storeFile=../my-release-key.jks
